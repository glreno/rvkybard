<svg width="@{W}" height="@{H}">
@include{TOP+'sinclair/zx81/keys/keyTemplate.svgt'}
<text x="@{keyW*.25}" y="@{keyY+cellH*2+FS*.3}" dominant-baseline="middle" text-anchor="middle" font-size="@{FS}" fill="@{TXTC}" font-family="sans-serif">@{name}</text>
<g transform='translate(@{keyW*.6+SX},@{keyY+FSk*1+SY})'>
    @include{TOP+INC2;pxsz=P}
</g>
<g transform='translate(@{keyW*.7},@{keyY+cellH*3-FS*.3})'>
    @include{TOP+INC1;colour=TXTC;BC=TXTC;pxsz=P}
</g>
</svg>
